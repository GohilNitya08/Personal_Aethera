# Application
APP_NAME=AETHERA API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS: comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=aethera_user
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=aethera

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_FRONTEND_REDIRECT_URI=http://localhost:5173/oauth/callback
# Set true when the callback is served over HTTPS (required in production).
GOOGLE_OAUTH_COOKIE_SECURE=false


# Google Cloud Storage
GCS_BUCKET_NAME=
GCS_OBJECT_PREFIX=aethera
GCS_SIGNED_URL_EXPIRE_MINUTES=15
MAX_UPLOAD_SIZE_BYTES=104857600

# SMTP / Password Reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Password Reset OTP
PASSWORD_RESET_OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5

# Google Cloud Storage
GCS_BUCKET_NAME=
GCS_OBJECT_PREFIX=aethera
MAX_UPLOAD_SIZE_BYTES=104857600

# SMTP / Password Reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Password Reset OTP
PASSWORD_RESET_OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
